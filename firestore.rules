rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function sameAgeBand(roomData) {
      return hasProfile() &&
        roomData.ageBand == myProfile().ageBand;
    }

    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'ageBand', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.ageBand in ['13-15', '16-17'];
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && (
        (resource.data.status == 'open' && sameAgeBand(resource.data)) ||
        exists(memberPath(roomId, request.auth.uid))
      );

      allow create: if signedIn()
        && hasProfile()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.ageBand == myProfile().ageBand
        && request.resource.data.participantCount == 1
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 8
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'title', 'topic', 'description', 'hostUid', 'hostName',
          'ageBand', 'participantCount', 'maxParticipants',
          'status', 'createdAt', 'updatedAt'
        ]);

      allow update: if signedIn() && (
        (
          sameAgeBand(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantCount', 'updatedAt'])
          && request.resource.data.participantCount
            == resource.data.participantCount + 1
          && !exists(memberPath(roomId, request.auth.uid))
          && existsAfter(memberPath(roomId, request.auth.uid))
          && getAfter(memberPath(roomId, request.auth.uid)).data.uid
            == request.auth.uid
        ) ||
        (
          exists(memberPath(roomId, request.auth.uid))
          && !existsAfter(memberPath(roomId, request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantCount', 'updatedAt'])
          && request.resource.data.participantCount
            == resource.data.participantCount - 1
        ) ||
        (
          resource.data.hostUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'closed'
        )
      );

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if signedIn() &&
          (sameAgeBand(get(/databases/$(database)/documents/rooms/$(roomId)).data)
            || request.auth.uid == memberUid);

        allow create: if signedIn()
          && request.auth.uid == memberUid
          && hasProfile()
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ageBand
            == myProfile().ageBand
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'joinedAt'
          ]);

        allow delete: if signedIn() && request.auth.uid == memberUid;
        allow update: if false;
      }
    }
  }
}
